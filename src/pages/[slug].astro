---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/2026/Base.astro';
import Section from '../components/2026/guide/Section.astro';

// セクションブロック型 (pages) とマークダウン型 (pagesMd) の両方をこのルートで捌く
export async function getStaticPaths() {
  const sectionPages = await getCollection('pages');
  const mdPages = await getCollection('pagesMd');
  return [
    ...sectionPages.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, kind: 'sections' as const },
    })),
    ...mdPages.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, kind: 'md' as const },
    })),
  ];
}

const { entry, kind } = Astro.props;
// Sveltia のプレビューと同様に、単一の改行も <br> として反映する
// (セクションブロックの本文と同じ marked + breaks で描画)
marked.use({ breaks: true });
const mdHtml = kind === 'md' ? (marked.parse(entry.body ?? '') as string) : null;
---

<Base title={`${entry.data.title} - RASHINBAN 2026`} description={entry.data.description}>
  <div class="page-bg">
    <div class="article-page guide-page">
      <div class="container">
        <div class="article-page__head">
          <h1 class="article-page__news">{entry.data.title}</h1>
          <a class="btn-pill" href="/">Back to Top Page</a>
        </div>

        {
          kind === 'sections' ? (
            entry.data.sections.map((section) => <Section section={section} />)
          ) : (
            <div class="md-page-body" set:html={mdHtml} />
          )
        }

        <p class="article-page__back">
          <a class="btn-pill" href="#">Back to Top</a>
        </p>
      </div>
    </div>
  </div>
</Base>
