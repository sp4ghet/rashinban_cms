---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Heading from './Heading.astro';

// デザイン同様、本文中の改行をそのまま <br> にする
marked.use({ breaks: true });

const { section } = Astro.props;
const md = (src: string) => marked.parse(src) as string;

// 支援フローのアイコン (Bootstrap Icons)。握手アイコンが無いためマッチングは people-fill で代用
const FLOW_ICONS: Record<string, string> = {
  person: 'bi-person-fill',
  match: 'bi-people-fill',
  chat: 'bi-chat-fill',
  money: 'bi-cash-coin',
};

// 申請選手一覧: レートの高い順 (同率は名前順)
const players =
  section.type === 'applications'
    ? (await getCollection('players')).sort(
        (a, b) => b.data.rating - a.data.rating || a.data.name.localeCompare(b.data.name)
      )
    : [];
const supporters = section.type === 'supporters' ? await getCollection('supporters') : [];
const generalSupporters = supporters.filter((s) => !s.data.player);
const designatedSupporters = supporters.filter((s) => s.data.player);
---

{
  section.type === 'text' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      {section.notice && <div class="guide-notice" set:html={md(section.notice)} />}
      {section.body && <div class="guide-body" set:html={md(section.body)} />}
      {section.image && <img class="guide-image" src={section.image} alt="" />}
    </section>
  )
}

{
  section.type === 'gameday' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      <div class="guide-gameday">
        {section.days.map((day) => (
          <div class="guide-gameday__row">
            <div class="date-badge date-badge--boxed guide-gameday__badge">
              <span class="date-badge__day">{day.label}</span>
              <span class="date-badge__date">{day.date}</span>
              <span class="date-badge__dow">{day.dow}</span>
            </div>
            <div class="guide-gameday__text">
              {day.description && <p>{day.description}</p>}
              {day.note && <p class="guide-gameday__note">{day.note}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

{
  section.type === 'venue' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      <div class="guide-venue">
        {section.photo && <img src={section.photo} alt={`${section.name}の会場写真`} />}
        <div>
          <p class="guide-venue__name">{section.name}</p>
          {section.address && <p class="guide-venue__address">{section.address}</p>}
          {section.access && <p class="guide-venue__access">{section.access}</p>}
          {section.mapsUrl && (
            <p class="guide-venue__map">
              <a class="btn-pill" href={section.mapsUrl} target="_blank" rel="noreferrer">
                Google Maps
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}

{
  section.type === 'tickets' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      {section.intro && <div class="guide-body" set:html={md(section.intro)} />}
      <div class:list={['guide-tickets', { 'guide-tickets--presale': !section.onSale }]}>
        {!section.onSale && section.saleStartText && (
          <p class="guide-tickets__presale-msg">{section.saleStartText}</p>
        )}
        {section.items.map((item) => {
          const clickable = section.onSale && !item.soldOut && section.url;
          const Bar = clickable ? 'a' : 'div';
          return (
            <>
              {item.separatorAbove && <hr class="guide-tickets__separator" />}
              <Bar
                class:list={[
                  'ticket-bar',
                  {
                    'ticket-bar--link': clickable,
                    'ticket-bar--soldout': section.onSale && item.soldOut,
                    'ticket-bar--disabled': !section.onSale,
                  },
                ]}
                href={clickable ? section.url : undefined}
                target={clickable ? '_blank' : undefined}
                rel={clickable ? 'noreferrer' : undefined}
                data-ga-ticket={clickable ? item.label : undefined}
                data-ga-ticket-url={clickable ? section.url : undefined}
              >
                <p class="ticket-bar__title">
                  <span class="ticket-bar__label">{item.label}</span>
                  <span class="ticket-bar__price">{item.price}</span>
                  <span class="ticket-bar__tax">（税込）</span>
                  {clickable && <i class="ticket-bar__external bi bi-box-arrow-up-right" />}
                </p>
                {item.features.length > 0 && (
                  <ul class="ticket-bar__features">
                    {item.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                )}
              </Bar>
            </>
          );
        })}
      </div>
      {section.notes && <div class="guide-body guide-tickets__notes" set:html={md(section.notes)} />}
    </section>
  )
}

{
  section.type === 'program' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      <div class="program">
        {section.items.map((item, i) => {
          const FormBar = item.formUrl ? 'a' : 'div';
          return (
            <>
              {i > 0 && <hr class="guide-rule" />}
              <div class="program__item">
                <h3 class="program__title">{item.title}</h3>
                {item.lead && <div class="guide-lead" set:html={md(item.lead)} />}
                {item.formLabel && (
                  <FormBar
                    class:list={['form-bar', { 'form-bar--link': !!item.formUrl }]}
                    href={item.formUrl || undefined}
                    target={item.formUrl ? '_blank' : undefined}
                    rel={item.formUrl ? 'noreferrer' : undefined}
                  >
                    {item.formLabel}
                    {item.formUrl && <i class="form-bar__external bi bi-box-arrow-up-right" />}
                  </FormBar>
                )}
                {item.body && <div class="guide-body" set:html={md(item.body)} />}
                {item.flow.length > 0 && (
                  <div class="flow">
                    {item.flowLabel && <p class="flow__label">{item.flowLabel}</p>}
                    <ol class="flow__steps">
                      {item.flow.map((step) => (
                        <li class="flow__step">
                          <i class:list={['flow__icon', 'bi', FLOW_ICONS[step.icon]]} aria-hidden="true" />
                          <span class="flow__title">{step.title}</span>
                          {step.note && <span class="flow__note">{step.note}</span>}
                        </li>
                      ))}
                    </ol>
                  </div>
                )}
              </div>
            </>
          );
        })}
      </div>
    </section>
  )
}

{
  section.type === 'applications' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      {section.intro && <div class="guide-lead" set:html={md(section.intro)} />}
      {players.length > 0 ? (
        <ul class="patron-cards">
          {players.map((player) => {
            const { supported, supporter } = player.data;
            return (
              <li class:list={['patron-card', { 'patron-card--supported': supported }]}>
                {supported && (
                  <div class="patron-card__overlay">
                    <span class="patron-card__overlay-title">支援成立</span>
                    {supporter && <span class="patron-card__overlay-name">({supporter})</span>}
                  </div>
                )}
                <p class="patron-card__name">{player.data.name}</p>
                <p class="patron-card__meta">
                  {player.data.geoguessrUrl ? (
                    <a href={player.data.geoguessrUrl} target="_blank" rel="noreferrer">
                      GeoGuessr Account[Link]
                    </a>
                  ) : (
                    'GeoGuessr'
                  )}
                </p>
                <p class="patron-card__meta">RATING:{player.data.rating}</p>
                {player.data.comment && <p class="patron-card__comment">{player.data.comment}</p>}
              </li>
            );
          })}
        </ul>
      ) : (
        section.emptyText && <p class="guide-body">{section.emptyText}</p>
      )}
    </section>
  )
}

{
  section.type === 'supporters' && (
    <section class="guide-section">
      <Heading en={section.headingEn} ja={section.headingJa} />
      {section.intro && <div class="guide-lead" set:html={md(section.intro)} />}
      <div class="supporters">
        <div class="supporters__group">
          <h3 class="supporters__label">{section.generalLabel}</h3>
          {generalSupporters.length > 0 && (
            <ul class="supporters__list">
              {generalSupporters.map((s) => (
                <li>{s.data.name}</li>
              ))}
            </ul>
          )}
        </div>
        <div class="supporters__group">
          <h3 class="supporters__label">{section.designatedLabel}</h3>
          {designatedSupporters.length > 0 && (
            <ul class="supporters__list">
              {designatedSupporters.map((s) => (
                <li>
                  {s.data.name}({s.data.player})
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}
