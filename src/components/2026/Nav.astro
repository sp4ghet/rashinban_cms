  <a href="/" class="nav__logo">
    <img src="/assets/2026/logo-side-white.svg" alt="RASHINBAN" />
  </a>
  <button class="nav__toggle" id="nav-toggle" aria-label="メニュー" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>

  {/* 右からスライドインする赤いドロワー (Figma: 2026_web_about) */}
  <div class="nav__drawer">
    <ul class="nav__links">
      <li><a href="/#about" class="nav__link">ABOUT</a></li>
      <li><a href="/#news" class="nav__link">NEWS</a></li>
      <li><a href="/#broadcast" class="nav__link">BROADCAST</a></li>
      <li><a href="/#tournament" class="nav__link">TOURNAMENT</a></li>
      <li><a href="/#join-us" class="nav__link">JOIN US</a></li>
      <li><a href="/#faq" class="nav__link">FAQ</a></li>
    </ul>

    <div class="nav__drawer-footer">
      <ul class="nav__socials">
        <li><a href="https://x.com/rashinban_geo" target="_blank" rel="noreferrer" aria-label="X"><i class="bi bi-twitter"></i></a></li>
        <li><a href="https://twitch.tv/sp4geo" target="_blank" rel="noreferrer" aria-label="Twitch"><i class="bi bi-twitch"></i></a></li>
        <li><a href="https://youtube.com/@sp4geo" target="_blank" rel="noreferrer" aria-label="YouTube"><i class="bi bi-youtube"></i></a></li>
