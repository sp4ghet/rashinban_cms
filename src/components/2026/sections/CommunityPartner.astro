---
const logoPath = '/assets/2026/スポンサーロゴ';
---

<section class="section community-partner" id="community-partner" aria-labelledby="community-partner-title">
  <div class="container">
    <h2 class="section-title" id="community-partner-title">
      <span class="section-title__en">COMMUNITY PARTNER</span>
      <span class="section-title__ja">コミュニティ パートナー</span>
    </h2>

    <div class="community-partner__logos">
      <img src={`${logoPath}/geojapan.png`} alt="GeoJapan" width="270" height="152" loading="lazy" decoding="async" />
      <img src={`${logoPath}/miturin 1.png`} alt="みつりんワールド" width="269" height="191" loading="lazy" decoding="async" />
    </div>
  </div>
</section>
