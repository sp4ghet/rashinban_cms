---
const logoPath = '/assets/2026/スポンサーロゴ';
---

<section class="section sponsor" id="sponsor" aria-labelledby="sponsor-title">
  <div class="container">
    <h2 class="section-title" id="sponsor-title">
      <span class="section-title__en">SPONSOR</span>
      <span class="section-title__ja">スポンサー</span>
    </h2>

    <div class="sponsor__logos">
      <div class="sponsor__row sponsor__row--lead">
        <img src={`${logoPath}/tamura-builds.svg`} alt="TAMURA BUILDS" width="598" height="87" loading="lazy" decoding="async" />
      </div>
      <div class="sponsor__row sponsor__row--partners">
        <img src={`${logoPath}/geo_logo.svg`} alt="GeoGuessr" width="208" height="40" loading="lazy" decoding="async" />
        <img src={`${logoPath}/ajinomoto.gif`} alt="味の素株式会社" width="1800" height="1298" loading="lazy" decoding="async" />
      </div>
      <div class="sponsor__row sponsor__row--supporters">
        <img src={`${logoPath}/geoguessr-record.svg`} alt="GeoGuessr Record" width="900" height="114" loading="lazy" decoding="async" />
        <img src={`${logoPath}/chofu-hernia-clinic.svg`} alt="調布駅前そけいヘルニアクリニック" width="482" height="40" loading="lazy" decoding="async" />
      </div>
      <div class="sponsor__row sponsor__row--community">
        <img src={`${logoPath}/bfcc.png`} alt="BFCC — Powered by バラジオ放送局" width="1000" height="500" loading="lazy" decoding="async" />
        <img src={`${logoPath}/kawaii-shisshi.svg`} alt="かわいいしっしー" width="882" height="362" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>
